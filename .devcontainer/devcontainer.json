// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/docker-existing-dockerfile
{
    "name": "alliance-hpm-dev",
    "build": {
        "dockerfile": "../Dockerfile",
        "context": "..",
        "args": {
            "USERNAME": "alliance",
             "USER_UID": "1000",
            "USER_GID": "1000"
        }
    },
    
    "remoteUser": "alliance",
    "workspaceFolder": "/workspace", 
    "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=cached",
    "privileged": true,

    "mounts": [
        {
            "source": "/dev",
            "target": "/dev",
            "type": "bind"
        },
        // WSL home — opencode binary (~/.opencode/bin/opencode)
        // Adjust distro/username if yours differ:
        //   \\\\wsl.localhost\\<distro>\\home\\<username>
        {
            "source": "\\\\wsl.localhost\\archlinux\\home\\kaiser",
            "target": "/mnt/wsl-home",
            "type": "bind"
        },
        // Windows user profile — opencode XDG config & auth
        // ($HOME/.config/opencode, $HOME/.local/share/opencode)
        {
            "source": "${localEnv:USERPROFILE}",
            "target": "/mnt/win-home",
            "type": "bind"
        }
        // -- Arch Linux (native Docker) alternative --
        // Comment out both mounts above and uncomment below:
        // {
        //     "source": "${localEnv:HOME}",
        //     "target": "/mnt/home",
        //     "type": "bind"
        // }
    ],
    "onCreateCommand": "bash -c 'mkdir -p ~/.local/share/opencode; [ -d /mnt/win-home/.config/opencode ] && ln -sfn /mnt/win-home/.config/opencode ~/.config/opencode; [ -d /mnt/wsl-home/.opencode ] && ln -sfn /mnt/wsl-home/.opencode ~/.opencode; for cfg in codex claude; do for src in /mnt/wsl-home/.$cfg /mnt/win-home/.$cfg; do [ -d \"$src\" ] && ln -sfn \"$src\" ~/.$cfg && break; done; done; [ -f /mnt/win-home/.local/share/opencode/auth.json ] && ln -sfn /mnt/win-home/.local/share/opencode/auth.json ~/.local/share/opencode/auth.json; true'",
    "postCreateCommand": "bash -c 'grep -q \".opencode/bin\" ~/.zshrc || echo \"export PATH=\\\"\\$HOME/.opencode/bin:\\$PATH\\\"\" >> ~/.zshrc; true'",
    "postStartCommand": "bash -c 'mkdir -p ~/.local/share/opencode; [ -d /mnt/win-home/.config/opencode ] && ln -sfn /mnt/win-home/.config/opencode ~/.config/opencode; [ -d /mnt/wsl-home/.opencode ] && ln -sfn /mnt/wsl-home/.opencode ~/.opencode; [ -f /mnt/win-home/.local/share/opencode/auth.json ] && ln -sfn /mnt/win-home/.local/share/opencode/auth.json ~/.local/share/opencode/auth.json; true'",
    "containerEnv": {
        "DISPLAY": "${localEnv:DISPLAY}",
        "HTTP_PROXY": "${localEnv:HTTP_PROXY}",
        "HTTPS_PROXY": "${localEnv:HTTPS_PROXY}",
        "NO_PROXY": "${localEnv:NO_PROXY}",
        "http_proxy": "${localEnv:http_proxy}",
        "https_proxy": "${localEnv:https_proxy}",
        "no_proxy": "${localEnv:no_proxy}",
        "HOST_WORKSPACE_FOLDER": "${localWorkspaceFolder}",
        "HPM_SDK_BASE": "/workspace/hpm_sdk",
        "HPM_OCD_SCRIPTS": "/workspace/hpm_sdk/boards/openocd",
        "HPM_OPENOCD_PREFIX": "/workspace/tools/openocd-hpm/install"
    },
    "runArgs": [
        "--network=host"
    ],
    "customizations": {
        "vscode": {
            "settings": {
                "remote.autoForwardPorts": false ,
                "clangd.path": "/usr/bin/clangd",
                "clangd.arguments": ["--log=error"]
            },
            "extensions": [
                // C++ language support
                "llvm-vs-code-extensions.vscode-clangd",
                // Cortex Debug (OpenOCD/J-Link debugging)
                "marus25.cortex-debug",
                // Python language support
                "ms-python.vscode-pylance",
                "ms-python.python",
                "ms-python.debugpy",
                // CMake language support
                "KylinIdeTeam.cmake-intellisence",
                // Code spell checking
                "streetsidesoftware.code-spell-checker",
                // Git enhancements
                "mhutchie.git-graph"
            ]
        }
    }
}
