Documentation:
  CommentFormat: Doxygen
Diagnostics:
  UnusedIncludes: Strict
  MissingIncludes: Strict
  Includes:
    IgnoreHeader:
      - "bits/.+h" # https://github.com/llvm/llvm-project/issues/68213
  ClangTidy:
    FastCheckFilter: Loose
    Remove:
      - readability-inconsistent-declaration-parameter-name # Unable to be suppressed by NOLINT
CompileFlags:
  Add:
    - "-Wextra-semi"
    - "-I/opt/riscv32-gnu-toolchain-elf-bin/lib/gcc/riscv32-unknown-elf/15.2.0/include"
    - "-I/opt/riscv32-gnu-toolchain-elf-bin/riscv32-unknown-elf/include"
